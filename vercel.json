{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "web",
  "functions": {
    "api/ai/extract.mjs": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/guides/pdf-to-json",
      "destination": "/guide-pdf-to-json.html"
    },
    {
      "source": "/integrations",
      "destination": "/integrations.html"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/releases",
      "destination": "/releases.html"
    },
    {
      "source": "/releases/",
      "destination": "/releases.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/admin",
      "destination": "/community.html"
    }
  ],
  "redirects": [
    {
      "source": "/guides.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guide-pdf-to-json.html",
      "destination": "/guides/pdf-to-json",
      "permanent": true
    },
    {
      "source": "/integrations.html",
      "destination": "/integrations",
      "permanent": true
    },
    {
      "source": "/guides/",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/pdf-to-json/",
      "destination": "/guides/pdf-to-json",
      "permanent": true
    },
    {
      "source": "/integrations/",
      "destination": "/integrations",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "page-signal.vercel.app"
        }
      ],
      "destination": "https://www.pagesignal.studio/:path*",
      "permanent": true
    }
  ]
}
