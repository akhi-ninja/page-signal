{
  "manifest_version": 3,
  "name": "PageSignal — Document Workspace",
  "version": "0.2.1",
  "minimum_chrome_version": "119",
  "description": "Extract fields from PDFs and images in the PageSignal side panel.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_title": "Open PageSignal",
    "default_icon": {
      "16": "icons/pagesignal-16.png",
      "32": "icons/pagesignal-32.png",
      "48": "icons/pagesignal-48.png",
      "128": "icons/pagesignal-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://www.pagesignal.studio"
  },
  "host_permissions": [
    "https://www.pagesignal.studio/*"
  ],
  "icons": {
    "16": "icons/pagesignal-16.png",
    "32": "icons/pagesignal-32.png",
    "48": "icons/pagesignal-48.png",
    "128": "icons/pagesignal-128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://www.pagesignal.studio/*"
    ]
  }
}
